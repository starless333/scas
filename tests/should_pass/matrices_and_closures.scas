// Matrices are rectangular nested arrays; comma indexing chains indexes.
let matrix = [1, 2, 3; 4, 5, 6; 7, 8, 9];
print(matrix[2, 1]);

fn make_shift(offset) {
    fn shift(value) = value + offset;
    return shift;
}

let shift_by_five = make_shift(5);
let values = [1, 2, 3];
print(shift_by_five(values[0]));
print(values + [4, 5]);
