/// SCAS builtin rendering gallery.
/// Build this file with `scas build tests/render_all_builtins.scas builtins.tex`.
\{
    abs(-3);
    sqrt(x);
    cbrt(x);
    exp(x);
    ln(x);
    log(x, b);
    log10(x);
    log2(x);
    sin(x);
    cos(x);
    tan(x);
    sec(x);
    csc(x);
    cot(x);
    asin(x);
    acos(x);
    atan(x);
    atan2(1, 2);
    sinh(x);
    cosh(x);
    tanh(x);
    asinh(x);
    acosh(x);
    atanh(x);
    erf(x);
    erfc(x);
    gamma(x);
    lgamma(x);
    floor(3 / 2);
    ceil(3 / 2);
    round(3 / 2);
    trunc(3 / 2);
    min(2, 3);
    max(2, 3);
    hypot(3, 4);
    gcd(84, 30);
    lcm(12, 18);
    sign(-9);
    degrees(pi);
    radians(180);
    evalf(pi);

    simplify(x + x);
    expand((x + 1)^3);
    factor(x^2 - 1);
    apart((x^2 + 1) / (x + 1));
    together(1 / x + 1 / (x + 1));
    horner(x^3 + 2x + 1);
    collect(x^2 + 2x^2 + x, x);
    subs(x^2 + y, x, 3);
    solve(x^2 - 1, x);

    derivative(sin(x), x);
    integral(x^2, x);
    definite_integral(x^2, x, 0, 1);
    limit(sin(x) / x, x, 0);
    series(exp(x), x, 0, 4);
    sum(k^2, k, 1, n);
    product(k, k, 1, n);
    gradient(x^2 + y^2, [x, y]);
    jacobian([x*y, x + y], [x, y]);
    hessian(x^2 + x*y + y^2, [x, y]);
    multiple_integral(x*y, [x, y]);
    dsolve([1, -3, 2], x);

    assume_nonzero(a_nz);
    assume_nonnegative(a_nn);
    assume_positive(a_pos);
    assume_negative(a_neg);
    assume_integer(a_int);
    assume_real(a_real);
    assume(a_general > 0);
    forget_assumptions();

    transpose([1, 2; 3, 4]);
    trace([1, 2; 3, 4]);
    det([1, 2; 3, 4]);
    rank([1, 2; 2, 4]);
    rref([1, 2; 3, 4]);
    inverse([1, 2; 3, 4]);
    matmul([1, 2; 3, 4], [5, 6; 7, 8]);
    dot([1, 2], [3, 4]);
    cross([1, 0, 0], [0, 1, 0]);
    norm([3, 4]);
    solve_linear([2, 1; 1, 3], [1, 2]);

    transpose_steps([1, 2; 3, 4]);
    trace_steps([1, 2; 3, 4]);
    det_steps([1, 2; 3, 4]);
    rank_steps([1, 2; 2, 4]);
    rref_steps([1, 2; 3, 4]);
    inverse_steps([1, 2; 3, 4]);
    matmul_steps([1, 2; 3, 4], [5, 6; 7, 8]);
    dot_steps([1, 2], [3, 4]);
    cross_steps([1, 0, 0], [0, 1, 0]);
    norm_steps([3, 4]);
    solve_linear_steps([2, 1; 1, 3], [1, 2]);

    characteristic_polynomial([1, 2; 3, 4], lambda);
    eigenvalues([2, 0; 0, 3]);
    eigenvectors([2, 0; 0, 3]);
    lu([4, 3; 6, 3]);
    qr([1, 0; 0, 1]);
    cholesky([4, 2; 2, 3]);
    lu_steps([4, 3; 6, 3]);
    qr_steps([1, 0; 0, 1]);
    cholesky_steps([4, 2; 2, 3]);
    null_space([1, 2, 3; 2, 4, 6]);
    column_space([1, 2, 3; 2, 4, 7]);
    gram_schmidt([[1, 0], [1, 1]]);
    projection([1, 2], [1, 0]);
    change_basis([2, 3], [[1, 0], [0, 1]]);
    matrix_exp([1, 0; 0, 2]);
    jordan_form([2, 1; 0, 2]);

    degree(3x^4 - 1, x);
    coefficients(3x^2 + 2x - 1, x);
    resultant(x^2 + 1, x + 1, x);
    discriminant(x^3 - 3x + 2, x);
    polynomial_gcd(x^3 - x, x^2 - 1, x);
    polynomial_divrem(x^3 - 1, x - 1, x);
\}
